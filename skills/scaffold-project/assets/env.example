# Run mode: development | testing | production
#   development — native Flask server, debug on
#   testing     — native Flask server, debug on
#   production  — waitress WSGI server, debug off
APP_ENV=development

# App and MongoDB are assumed co-located (same host). Set per environment;
# testing may point at a remote/shared DB.
MONGO_URI=mongodb://localhost:27017
DB_NAME=__DB_NAME__

SECRET_KEY=change-me-in-production
PORT=5000

# Site identity for SEO (meta tags, canonical URLs, robots/sitemap)
SITE_NAME=__PROJECT_NAME__
SITE_URL=http://localhost:5000
